{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esp-iris.dev/schema/system-update-manifest-v1.json",
  "title": "ESP-Iris System Update Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "source_layout_sha256",
    "target_layout_sha256",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "esp-iris-system-update/v1"
    },
    "release": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "minimum_recovery_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "signature": {
      "description": "Present only for signed bundles.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id"],
      "properties": {
        "algorithm": {
          "const": "ecdsa-p256-sha256"
        },
        "key_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chip_id", "flash_size"],
      "properties": {
        "chip_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "flash_size": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 4294967295,
          "multipleOf": 4096
        }
      }
    },
    "source_layout_sha256": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "target_layout_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "target_offset",
          "size",
          "sha256",
          "file"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "kind": {
            "enum": [
              "bootloader",
              "partition_table",
              "application",
              "data"
            ]
          },
          "flags": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "target_offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^/\\\\]+$"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
