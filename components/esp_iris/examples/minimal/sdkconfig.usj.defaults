CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ESP-Iris exclusively owns the USB Serial/JTAG CDC serial channel. The JTAG
# interface remains available; release the Gateway endpoint before flashing.
CONFIG_ESP_IRIS_TRANSPORT_USB_SERIAL_JTAG=y
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328
