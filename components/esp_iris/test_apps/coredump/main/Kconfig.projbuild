menu "ESP-Iris private board-test settings"

config ESP_IRIS_TEST_WIFI_SSID
    string "Board-test Wi-Fi SSID"
    default ""

config ESP_IRIS_TEST_WIFI_PASSWORD
    string "Board-test Wi-Fi password"
    default ""

config ESP_IRIS_TEST_PAIRING_TOKEN
    string "Initial 64-hex pairing token"
    default ""

config ESP_IRIS_TEST_NEXT_PAIRING_TOKEN
    string "Rotated 64-hex pairing token"
    default ""

config ESP_IRIS_TEST_AUTO_MARK_HEALTHY
    bool "Automatically accept a pending OTA image"
    default y
    help
        Emit the ESP-Iris healthy lifecycle event after a normal pending OTA
        boot. Crash injection runs before this check, so an armed pending image
        still crashes and exercises bootloader rollback and coredump retention.

endmenu
